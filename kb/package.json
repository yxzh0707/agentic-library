    "lint": "pnpm -r run lint",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "@types/node": "^20.16.10",
    "prettier": "^3.3.3",
    "eslint": "^9.11.1",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0"
  }
}
