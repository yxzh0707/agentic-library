{
  "name": "knowledge-base",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first, agent-oriented, self-organizing knowledge base",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
